{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "git checkout *": "ask",
      "git reset *": "ask",
      "git restore *": "ask",
      "git stash *": "ask",
      "*": "allow"
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "minimax-coding-plan/MiniMax-M3",
      "permission": "allow"
    },
    "plan": {
      "mode": "primary",
      "model": "minimax-coding-plan/MiniMax-M3",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "code-reviewer": {
      "mode": "subagent",
      "description": "Revisa código en busca de bugs, malas prácticas y mejoras de seguridad",
      "model": "minimax-coding-plan/MiniMax-M3",
      "permission": "allow"
    },
    "explore": {
      "mode": "subagent",
      "permission": "allow"
    },
    "scout": {
      "mode": "subagent",
      "permission": "allow"
    }
  }
}