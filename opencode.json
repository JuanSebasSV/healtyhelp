{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": ["codebase-memory-mcp"],
      "enabled": true,
      "timeout": 30000
    },
    "semgrep": {
      "type": "local",
      "command": ["semgrep-mcp"],
      "enabled": true
    }
  },
  "model": "minimax-coding-plan/MiniMax-M3",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "minimax-coding-plan/MiniMax-M3",
      "permission": "allow"
    },
    "plan": {
      "mode": "primary",
      "model": "minimax-coding-plan/MiniMax-M3",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "code-reviewer": {
      "mode": "subagent",
      "description": "Revisa código en busca de bugs, malas prácticas y mejoras de seguridad",
      "model": "minimax-coding-plan/MiniMax-M3",
      "permission": "allow"
    },
    "explore": {
      "mode": "subagent",
      "permission": "allow"
    },
    "permission": {
      "bash": {
        "git checkout *": "ask",
        "git reset *": "ask",
        "git restore *": "ask",
        "git stash *": "ask",
        "*": "allow"
      }
    },
    "scout": {
      "mode": "subagent",
      "permission": "allow"
    }
  }
}
